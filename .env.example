# ---------------------------------------------------------------------------
# Partner Club WhatsApp Marketing System — environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit
# credentials. Only the variables your deployment uses are required.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# --- Database (required) ---------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/whatsapp_boardcast

# --- Frontend / CORS -------------------------------------------------------
# The exact browser origin(s) allowed to call the API.
FRONTEND_URL=http://localhost:3000
# Additional origins, comma-separated (optional).
CORS_ORIGINS=

# --- Authentication --------------------------------------------------------
# Use long random values. These defaults are for local development only.
ACCESS_TOKEN_SECRET=dev-access-token-secret-change-me
REFRESH_TOKEN_SECRET=dev-refresh-token-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_SECURE=false
# COOKIE_DOMAIN=
BCRYPT_ROUNDS=12

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

# --- WhatsApp Business Platform -------------------------------------------
# WHATSAPP_PROVIDER=mock keeps the integration simulated (no real sends).
# Set to `meta` and supply the credentials below to send for real.
WHATSAPP_PROVIDER=mock
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Require a provider-approved template before a campaign can be dispatched.
WHATSAPP_REQUIRE_APPROVED_TEMPLATES=true
MESSAGING_DAILY_CAP_PER_CONTACT=4

# --- Background jobs -------------------------------------------------------
# `memory` runs the in-process queue (no Redis needed). `redis` requires REDIS_URL.
QUEUE_DRIVER=memory
REDIS_URL=

# --- Seed data (local development only) ------------------------------------
SEED_ADMIN_EMAIL=admin@partnerclub.local
SEED_ADMIN_PASSWORD=ChangeMe-Admin-2026
SEED_ADMIN_NAME=Partner Club Administrator
